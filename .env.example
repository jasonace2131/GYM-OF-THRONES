# =============================================================================
# GYM OF THRONES — Environment Variables Template
#
# Copy to server/.env and client/.env.local and fill in your own values.
# NEVER put real credentials in this file — it is committed to the repository.
# NEVER commit .env or .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER (NestJS) — copy to server/.env
# -----------------------------------------------------------------------------

# Supabase Postgres, POOLED connection. Used by the app at runtime.
# MUST carry ?pgbouncer=true and an explicit connection_limit, or interactive
# transactions intermittently fail with "prepared statement s0 already exists".
# Supabase dashboard → Project Settings → Database → Connection string → Transaction
DATABASE_URL="<pooled Supabase connection string, port 6543, with ?pgbouncer=true&connection_limit=1>"

# Supabase Postgres, DIRECT connection. Required by `prisma migrate`, which
# cannot run through the transaction pooler. Same credentials, port 5432.
# Supabase dashboard → Project Settings → Database → Connection string → Session
DIRECT_URL="<direct Supabase connection string, port 5432>"

# Supabase project URL. Public — it is also the JWKS endpoint access tokens
# are verified against, and the same value appears in the client section below.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# OPTIONAL. Bypasses row-level security entirely — treat like a DB superuser
# password. Nothing in the auth flow needs it; token verification uses the
# public JWKS. Server-side only, never in a NEXT_PUBLIC_ var.
# SUPABASE_SERVICE_KEY="your-service-role-key"

# OPTIONAL — leave unset unless a feature needs the Supabase admin API.
# The service_role key bypasses Row Level Security entirely: treat it like a
# database superuser password. Server-side only, never in client code, and
# never committed. Nothing in the auth flow needs it — token verification uses
# the public JWKS.
# SUPABASE_SERVICE_KEY="your-service-role-key-here"

# App
NODE_ENV="development"
PORT=4000

# CORS — comma-separated list of origins allowed to call the API
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# GYM OPERATING PARAMETERS
#
# All of these are validated by server/src/config/env.validation.ts and the
# server refuses to start if any is missing or out of range.
# -----------------------------------------------------------------------------

# IANA time zone. Validated by construction, so aliases such as Asia/Calcutta
# are accepted; a typo like Asia/Manilla crashes the boot rather than silently
# formatting as UTC forever.
GYM_TIMEZONE="Asia/Manila"

# HH:mm, 24-hour. Load-bearing: the station-token endpoint and the STATION_QR
# check-in path are gated on these hours. Staff-recorded entries never are.
GYM_OPEN_TIME="05:00"
GYM_CLOSE_TIME="22:00"

# Membership. GRACE_DAYS is the default for NEW terms only — it is snapshotted
# onto the membership at purchase.
MEMBERSHIP_GRACE_DAYS=3              # int 0-14
MEMBERSHIP_EXPIRING_SOON_DAYS=7      # int 1-30
MEMBERSHIP_FREEZE_MIN_DAYS=7         # int 1-30
MEMBERSHIP_FREEZE_MAX_DAYS=90        # int, >= MIN
MEMBERSHIP_FREEZE_ANNUAL_CAP_DAYS=90 # int, >= MAX, rolling 365 days
MEMBERSHIP_GRACE_ADMISSIONS_MAX=3    # int 0-14, admissions on grace per term
MEMBERSHIP_FREEZE_FEE_CENTAVOS=10000 # int 0-100000, ₱100; waived when medical

# Station display tokens. SECRET has no default and must be at least 32
# characters — the server will not start without it.
STATION_TOKEN_SECRET="<32-byte base64 — generate with: openssl rand -base64 32>"

# OPTIONAL, verify-only. Set this to the OLD secret while rotating
# STATION_TOKEN_SECRET, so badges signed before the rotation still verify.
# Remove it once the old batch has expired.
# STATION_TOKEN_SECRET_PREVIOUS="<previous 32-byte base64 secret>"
# Verify-only. Set this to the OLD secret on a rotation's first deploy so codes
# already on screen keep working; remove it on the second deploy to invalidate
# every outstanding token within one slot. Leave commented out normally.
# STATION_TOKEN_SECRET_PREVIOUS="<the previous STATION_TOKEN_SECRET value>"
STATION_TOKEN_SLOT_SECONDS=30        # int 15-120
STATION_TOKEN_BATCH_SIZE=10          # int 2-20

# Peppers a StationCredential secret before hashing. Never logged, never
# returned by any endpoint.
STATION_CREDENTIAL_PEPPER="<32-byte base64 — generate with: openssl rand -base64 32>"

# Peppers a request IP before it is hashed into CheckIn.originIpHash.
# A member's IP is personal data under the Data Privacy Act and clustering only
# ever needs equality, so the raw value is never stored. The pepper is what
# stops a leaked database from being walked back to real addresses.
IP_HASH_PEPPER="<32-byte base64 — generate with: openssl rand -base64 32>"

# Comma-separated CIDRs for the gym's own egress, e.g. "203.0.113.0/24".
# EMPTY IS LEGAL and means "every request looks off-site", which degrades the
# relay signal to noise rather than denying anyone — this list never decides
# an admission, only whether a quiet chip appears on the desk feed.
GYM_EGRESS_CIDRS=""

# Attendance thresholds. All are guesses sized against a modelled arrival
# pattern and are due a re-tune against the first thirty days of real data.
# Floor of the reopen window below (the scanned-by-mistake undo). It no longer
# delays check-out: a second scan offers a Check out button at any age.
CHECKIN_MIN_SESSION_MINUTES=20
# Scan within this many minutes of your own QR check-out = same visit reopened
# (left something at home). 0 disables; the mistake-undo window stays.
CHECKIN_REENTRY_GRACE_MINUTES=60
CHECKIN_STALE_VISIT_HOURS=3
CHECKIN_MAX_VISITS_PER_DAY=8
CHECKIN_OFFLINE_MAX_AGE_HOURS=12
# Soft anomaly thresholds. They raise a chip and a report line; they never deny.
STATION_FANOUT_SOFT_LIMIT=20
STATION_OFFSITE_SOFT_LIMIT=5

# Housekeeping
IDEMPOTENCY_RETENTION_HOURS=24       # int 1-168

# Exactly one instance may run the nightly jobs. Validated as the literal
# string 'true' or 'false' — z.coerce.boolean() would map "false" to true.
SCHEDULER_ENABLED="true"

# The emailed sign-in code: password, then a 6-digit code, on every sign-in.
# Literal string 'true'/'false'; UNSET MEANS 'true'. This is the KILL SWITCH:
# if email breaks (Resend misconfigured, daily quota hit), set 'false' on the
# API host and restart, and everyone signs in with the password alone until
# it is fixed. With it on and RESEND_API_KEY/RESEND_FROM unset, nobody can
# finish signing in — the API logs an error at boot. 'false' here because a
# local copy of this file usually has no Resend key; production sets 'true'.
LOGIN_CODE_REQUIRED="false"

# Cash drawer. A blind close beyond ±this figure demands a written note.
SHIFT_VARIANCE_NOTE_THRESHOLD_CENTAVOS=20000  # int >= 0, ₱200

# How members are told to pay, surfaced by the @Public() GET /config and
# rendered on /portal/pay. OPTIONAL — and unset is a SUPPORTED state, not a
# missing configuration: the endpoint returns null and the portal shows the
# cash instruction alone. A plausible-looking wrong GCash number on a payment
# screen sends a member's money to a stranger, so there is deliberately no
# placeholder default.
# GYM_GCASH_NUMBER="0917 000 0000"
# GYM_GCASH_NAME="Gym of Thrones"

# The member AI assistant, on Google Gemini. OPTIONAL — unset is a supported
# state, not a missing configuration: the server starts, logs a warning, and
# the assistant's routes return 503 while the portal hides the screen. The gym
# must be able to run without an AI bill.
#
# The free tier meters EACH MODEL SEPARATELY, so the assistant walks a list
# ordered by daily allowance (see server/src/assistant/gemini-models.ts) and
# moves to the next one on a 429. That is what keeps it answering all day
# instead of dying at lunchtime.
#
# Server-side only; never a NEXT_PUBLIC_ var.
# GEMINI_API_KEY="AIza..."
#
# OPTIONAL. Pins a preferred model to the FRONT of that list rather than
# replacing it, so tuning the first choice never gives up the fallbacks.
# The built-in list is gemini-3.1-flash-lite → gemini-2.5-flash-lite →
# gemini-2.5-flash. Do not pin a gemini-2.0 or 1.5 model: both lines are shut
# down and every ask would pay a failed round-trip before a model answered.
# GEMINI_MODEL="gemini-3.1-flash-lite"

# Outbound transactional email (Resend), used by POST /members to send the new
# member's magic-link invite. OPTIONAL — unset is a supported state: the
# server starts, logs a warning, and member creation still succeeds but
# returns `emailSent: false` so the CRM can offer "resend invite" once this is
# configured. Server-side only; never a NEXT_PUBLIC_ var.
# RESEND_API_KEY="re_..."
# The verified "From" address/name Resend sends as, e.g.
# "Gym of Thrones <hello@yourdomain.com>". Required alongside RESEND_API_KEY
# for sending to actually work.
# RESEND_FROM="Gym of Thrones <hello@yourdomain.com>"

# Is the gym VAT-registered? Drives the statutory senior/PWD computation:
# registered sellers net out the 12% before the 20% discount. Literal string.
GYM_VAT_REGISTERED="false"

# Seller identity printed on the counter Transaction Slip. All optional — a
# null line is OMITTED from the slip, never placeholdered. Must match the BIR
# COR exactly; TIN is 9 digits + 5-digit branch code.
# GYM_REGISTERED_NAME="Registered Name Per BIR COR"
# GYM_TRADE_NAME="Gym of Thrones"
# GYM_REGISTERED_ADDRESS="4th Floor, JWMGI Building, Taguig City 1630"
# GYM_TIN="987-654-321-00000"

# Above this net amount a GCash sale must carry the staff "seen in our GCash
# Transactions tab" tick. Unset = never required; recommended 100000 (₱1,000)
# so the ₱90 day pass is untouched and a membership is not.
# GCASH_VERIFY_THRESHOLD_CENTAVOS=100000

# -----------------------------------------------------------------------------
# CLIENT (Next.js) — copy to client/.env.local
#
# NEXT_PUBLIC_ variables are embedded in the browser bundle and are readable by
# anyone. Only ever put public values here. The anon key is designed to be
# public; the service_role key must never appear in this section.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# -----------------------------------------------------------------------------
# SEEDING — development convenience only
# -----------------------------------------------------------------------------

# OPTIONAL. Overrides the shared password seed-accounts.ts gives every role.
# The committed default is weak and public by design; set this if you ever run
# that script anywhere the accounts matter. It creates a DEV superuser, so
# never run it against a real deployment.
# SEED_ACCOUNT_PASSWORD="choose-something-else"
