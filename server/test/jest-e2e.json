{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@got/shared$": "<rootDir>/../../shared/src/index.ts"
  },
  "globalSetup": "<rootDir>/support/db.ts",
  "setupFiles": ["reflect-metadata"],
  "maxWorkers": 1,
  "testTimeout": 60000
}
